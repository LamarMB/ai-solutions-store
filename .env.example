# Пример переменных окружения. Скопируйте в .env.local и заполните при необходимости.
# Реальные значения (ключи, токены) никогда не коммитятся.

# SEO и индексация (читаются при сборке, подробности — docs/seo.md).
# Постоянный адрес сайта. Не задавайте временный preview-адрес.
# SITE_URL=https://example.ru
# Разрешить индексацию: только после утверждения домена и готовности сайта.
# Действует лишь вместе с https-адресом в SITE_URL. По умолчанию индексация запрещена.
# SITE_INDEXING=true

# ---------------------------------------------------------------------------
# VK-бот тестовой клиники (npm run bot:vk). Инструкция — docs/vk-bot-run.md.
# Реальные значения — только в .env.local на своём компьютере, не в Git и не в чат.

# ID сообщества ВКонтакте (число без минуса).
VK_GROUP_ID=242364009
# Ключ доступа сообщества: Управление → Работа с API → Ключи доступа.
# Права: «Сообщения сообщества» (+ «Управление сообществом» для npm run bot:check).
VK_GROUP_TOKEN=
# VK ID тестовых аккаунтов через запятую. Остальным бот не отвечает.
VK_ALLOWED_USER_IDS=
# VK ID администратора для уведомлений «позвать администратора» (необязательно).
# Администратор должен один раз написать сообществу, чтобы разрешить сообщения.
VK_ADMIN_USER_ID=
# Версия VK API.
# VK_API_VERSION=5.199

# OpenAI (необязательно). Без ключа бот работает по кнопкам и ключевым словам.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# Не больше запросов к OpenAI в сутки (защита бюджета).
# OPENAI_DAILY_REQUEST_LIMIT=500

# Файл базы SQLite с тестовыми записями и шагами диалогов.
# BOT_DB_PATH=.data/bot.sqlite
# Сколько часов бот молчит после передачи диалога администратору.
# BOT_HANDOFF_HOURS=12
# Сколько часов без активности хранится память разговора (жалоба, ответы, реплики).
# BOT_HISTORY_HOURS=24
# Сколько текстовых сообщений в минуту принимается от одного собеседника (защита от спама).
# BOT_MESSAGES_PER_MINUTE=12
# false — бот не задаёт вопросов о симптомах (травма, длительность, тревожные признаки),
# только подбирает направление и записывает. Меньше медицинских подробностей во ВКонтакте.
# BOT_MEDICAL_QUESTIONS=true

# Ключ шифрования медицинских сведений (32 байта в base64), один для бота и панели.
# Шифрует разговоры и согласия в базе; без ключа передача описания жалобы врачу выключена.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Хранить только в .env.local и в отдельной резервной копии: без ключа сведения не прочитать.
# Подробности — docs/medical-privacy.md.
MEDICAL_DATA_KEY=

# ---------------------------------------------------------------------------
# Админ-панель клиники (/admin). Инструкция — docs/admin-panel-deploy.md.
# Панель и бот работают с одной базой BOT_DB_PATH (см. выше) — путь должен совпадать.
# Первого сотрудника (владельца) создаёт владелец сервера: npm run admin:user -- create <логин>
# Остальных приглашает владелец из раздела «Сотрудники». Роли — docs/medical-privacy.md.
# Cookie входа только по https. false — лишь для локальной проверки по http.
# ADMIN_COOKIE_SECURE=true
# Дополнительные адреса панели (Origin) через запятую, если нужно.
# ADMIN_ALLOWED_ORIGINS=
