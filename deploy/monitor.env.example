# Мониторинг экземпляров клиник (docs/monitoring.md).
# Файл на сервере: /etc/demo-med/monitor.env, права 600, владелец root. В Git не попадает.

# --- Уведомления в Telegram (бесплатно) ------------------------------------
# Бот — у @BotFather (/newbot), токен — сюда. Чат: напишите боту или добавьте его в
# группу, затем id чата — из https://api.telegram.org/bot<токен>/getUpdates
# (поле chat.id; у групп — отрицательное). Без токена сообщения — только в журнале.
MONITOR_TELEGRAM_BOT_TOKEN=
MONITOR_TELEGRAM_CHAT_ID=
# Другой адрес Bot API (например, свой сервер telegram-bot-api), https без пути.
# MONITOR_TELEGRAM_API=https://api.telegram.org
# Имя сервера в сообщениях (по умолчанию — hostname).
# MONITOR_SERVER_NAME=

# --- Пороги ----------------------------------------------------------------
# Бот без связи с ВКонтакте дольше, минут.
# MONITOR_BOT_STALE_MINUTES=5
# Ожидание ответа панели, секунд.
# MONITOR_PANEL_TIMEOUT_SECONDS=5
# Последняя успешная копия старше, часов (копия — раз в сутки ночью).
# MONITOR_BACKUP_MAX_AGE_HOURS=30
# Клиника без настроек копий — тревога.
# MONITOR_REQUIRE_BACKUP=true
# Разделы диска и минимум свободного места (тревога, если меньше любого порога).
# MONITOR_DISK_PATHS=/,/var/lib/demo-med,/var/backups/demo-med
# MONITOR_DISK_MIN_FREE_PERCENT=10
# MONITOR_DISK_MIN_FREE_MB=1024
# Доступная память сервера, % (MemAvailable).
# MONITOR_MEMORY_MIN_AVAILABLE_PERCENT=10
# Память сервиса клиники относительно его лимита MemoryMax, %.
# MONITOR_UNIT_MEMORY_MAX_PERCENT=90
# Сертификат https истекает раньше, дней.
# MONITOR_CERT_WARN_DAYS=14

# --- Защита от спама ---------------------------------------------------------
# Тревога — после стольких неудачных проверок подряд (проверка — раз в 5 минут).
# MONITOR_FAIL_AFTER=2
# Напоминание о неисправленной проблеме — раз в столько часов (0 — не напоминать).
# MONITOR_REMIND_HOURS=24
# Ежедневная сводка «мониторинг работает» в этот час по времени сервера (-1 — выключить).
# MONITOR_DAILY_REPORT_HOUR=9
