# Резервное копирование одной клиники — отдельно от настроек бота и панели: эти
# значения получает только задача копирования (demo-med-backup@<id>).
# Файл на сервере: /etc/demo-med/backup/<CLINIC_ID>.env, права 600, владелец root.
# Создаётся командой deploy/clinic/new-clinic.sh backup-init <id> (BACKUP_KEY —
# сгенерирован). Инструкция — docs/backup-restore.md. В Git и журналы не попадает.

# Ключ шифрования копий (32 байта base64): свой у каждой клиники, не равен
# MEDICAL_DATA_KEY. Храните копию ВНЕ сервера (менеджер паролей владельца) —
# без него копии не расшифровать.
BACKUP_KEY=

# Внешнее хранилище (не этот сервер):
#   s3://<бакет>/<каталог>   — S3-совместимое хранилище; клиника получит подкаталог <каталог>/<id>
#   file:///<путь>           — смонтированный внешний диск или сетевое хранилище
BACKUP_TARGET=

# Для s3:// — адрес, регион и ключ сервисного аккаунта с доступом только к этому бакету.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Сколько копий хранить во внешнем хранилище (одна в сутки). 0 — не удалять:
# срок хранения задаётся правилом жизненного цикла в самом хранилище.
BACKUP_KEEP=30
# Зашифрованные копии на этом сервере — для быстрого отката, не резервирование.
BACKUP_LOCAL_DIR=/var/backups/demo-med/<clinic-id>
BACKUP_LOCAL_KEEP=3
