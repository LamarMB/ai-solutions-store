# Настройки экземпляра «Демо-Мед» для одной клиники.
# Файл на сервере: /etc/demo-med/clinics/<CLINIC_ID>.env, права 600, владелец root
# (systemd передаёт значения сервисам). Создаётся командой deploy/clinic/new-clinic.sh create —
# MEDICAL_DATA_KEY она генерирует сама. В Git, чат и журналы значения не попадают.
# Проверка до запуска: sudo deploy/clinic/new-clinic.sh check <CLINIC_ID>
# Инструкция — docs/clinic-instance-deploy.md.

# --- Экземпляр (systemd, nginx) --------------------------------------------
# Идентификатор: латиница в нижнем регистре, цифры, дефис (имя пользователя dm-<id>).
CLINIC_ID=<clinic-id>
# Порт панели на 127.0.0.1, свой у каждой клиники (3100–3999).
PANEL_PORT=<3101>
# Домен панели и Mini App (DNS → этот сервер).
PANEL_DOMAIN=<panel.clinic.example>
# Доверенный прокси перед nginx (например, российский прокси для Mini App), IPv4
# через запятую. Пусто — клиенты подключаются к nginx напрямую.
TRUSTED_PROXY_IPS=

# --- База ------------------------------------------------------------------
# Только в каталоге клиники; общий для бота и панели этой клиники.
BOT_DB_PATH=/var/lib/demo-med/<clinic-id>/bot.sqlite
# Ключ шифрования разговоров и согласий (генерируется при создании; хранить копию
# отдельно от резервных копий базы — без ключа сведения не прочитать).
MEDICAL_DATA_KEY=

# --- ВКонтакте -------------------------------------------------------------
# Сообщество клиники: одно сообщество — один экземпляр.
VK_GROUP_ID=<id сообщества>
# Ключ доступа сообщества (Управление → Работа с API): права «Сообщения сообщества».
VK_GROUP_TOKEN=
# demo — пометки «демо»; live — клиника-клиент (бот не запустится, пока в панели
# остались данные вымышленной клиники).
BOT_MODE=live
# Пока заполнено — бот отвечает только этим VK ID (проверка до открытия доступа).
# Пусто при BOT_MODE=live — бот отвечает всем пациентам.
VK_ALLOWED_USER_IDS=<VK ID тестировщиков через запятую>
# VK ID администратора клиники для уведомлений «позвать администратора».
VK_ADMIN_USER_ID=

# --- OpenAI (необязательно) ------------------------------------------------
# Без ключа бот работает по кнопкам и правилам. С ключом текст сообщений уходит во
# внешний ИИ-сервис (телефоны и почта вырезаются) — только после решения юриста.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_DAILY_REQUEST_LIMIT=500

# --- Панель ----------------------------------------------------------------
# Только https (по умолчанию true). false — запрещено проверкой для клиники.
# ADMIN_COOKIE_SECURE=true
# ADMIN_ALLOWED_ORIGINS=

# --- VK Mini App (необязательно, тариф «Оптимум») ---------------------------
# При открытом доступе бота (live без VK_ALLOWED_USER_IDS) не задавать: Mini App
# пока работает только для тестовых аккаунтов.
# VK_MINIAPP_ID=
# VK_MINIAPP_SECRET=
# MINIAPP_ALLOWED_USER_IDS=
